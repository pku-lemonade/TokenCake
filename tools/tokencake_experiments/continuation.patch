+def _assign_continuation_input_composer(node: Any) -> None:
+    default_composer = node.input_composer
+
+    def composer(task: TransferDataItem) -> LLMTextChunkChain:
+        chain = task.data
+        if isinstance(chain, dict) and len(chain) == 1:
+            chain = next(iter(chain.values()))
+        if (isinstance(chain, LLMTextChunkChain) and chain.chunks
+                and chain.chunks[0].text == node.system_prompt.text):
+            return LLMTextChunkChain(chunks=list(chain.chunks))
+        return default_composer(task)
+
+    node.assign_composer(is_input=True, composer=composer)
+
