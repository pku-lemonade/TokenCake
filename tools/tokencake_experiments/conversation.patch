 from agent.mcp.mcp_node import (
+    McpNode,
     McpConditionalExecutionNode,
@@ -232,6 +234,43 @@ def _annotate(
     return node
 
 
+def _assign_conversation_input_composer(node: Any, predecessors: list) -> None:
+    def composer(task: TransferDataItem) -> LLMTextChunkChain:
+        if isinstance(task.data, LLMTextChunkChain):
+            chains = [task.data]
+        elif isinstance(task.data, dict):
+            if set(task.data) != set(predecessors):
+                raise ValueError("Conversation input does not match DAG predecessors")
+            chains = [task.data[key] for key in predecessors]
+        else:
+            raise TypeError("Unsupported conversation input")
+        common = min((len(chain.chunks) for chain in chains), default=0)
+        for index in range(common):
+            if any(chain.chunks[index].text != chains[0].chunks[index].text
+                   for chain in chains[1:]):
+                common = index
+                break
+        chunks = list(chains[0].chunks[:common]) if chains else []
+        for chain in chains:
+            chunks.extend(chain.chunks[common:])
+        chunks.append(node.system_prompt)
+        return LLMTextChunkChain(chunks=chunks)
+
+    node.assign_composer(is_input=True, composer=composer)
+
+
+def _configure_conversation(graph: InDegreePriorityGraph) -> None:
+    for node in graph.nodes.values():
+        if not isinstance(node, LLMAppNode):
+            continue
+        predecessors = sorted(graph.predecessors(node.uuid),
+                              key=lambda key: graph.nodes[key].name)
+        _assign_conversation_input_composer(node, predecessors)
+        reusable = any(isinstance(graph.nodes[key], LLMAppNode)
+                       for key in graph.successors(node.uuid))
+        if isinstance(node, McpNode) and reusable:
+            node.add_kvargs(preserve_llm_output_after_tool=True,
+                           reusable_prefix=True, offload_eligible=True)
+
+
